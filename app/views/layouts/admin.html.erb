<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "관리자 — #{current_organization&.name}" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <div class="flex">
      <!-- 사이드바 -->
      <aside class="w-56 bg-white shadow-sm min-h-screen flex-shrink-0">
        <div class="p-4 border-b">
          <p class="font-bold text-blue-600"><%= current_organization&.name %></p>
          <p class="text-xs text-gray-500">관리자 패널</p>
        </div>
        <nav class="p-4 space-y-1">
          <%= link_to "대시보드", admin_root_path, class: "block px-3 py-2 rounded text-sm text-gray-700 hover:bg-gray-100" %>
          <%= link_to "회의실 관리", admin_rooms_path, class: "block px-3 py-2 rounded text-sm text-gray-700 hover:bg-gray-100" %>
          <%= link_to "예약 현황", admin_reservations_path, class: "block px-3 py-2 rounded text-sm text-gray-700 hover:bg-gray-100" %>
          <%= link_to "구독 관리", admin_subscription_path, class: "block px-3 py-2 rounded text-sm text-gray-700 hover:bg-gray-100" %>
          <hr class="my-2">
          <%= link_to "예약 앱 보기", tenant_root_path, class: "block px-3 py-2 rounded text-sm text-gray-500 hover:bg-gray-100" %>
          <%= link_to "로그아웃", destroy_user_session_path, data: { turbo_method: :delete }, class: "block px-3 py-2 rounded text-sm text-red-500 hover:bg-gray-100" %>
        </nav>
      </aside>

      <!-- 메인 콘텐츠 -->
      <div class="flex-1 p-8">
        <% if notice %>
          <div class="mb-4 bg-green-50 border border-green-200 text-green-800 rounded px-4 py-3 text-sm"><%= notice %></div>
        <% end %>
        <% if alert %>
          <div class="mb-4 bg-red-50 border border-red-200 text-red-800 rounded px-4 py-3 text-sm"><%= alert %></div>
        <% end %>
        <%= yield %>
      </div>
    </div>
  </body>
</html>
