<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Super Admin" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 min-h-screen">
    <div class="max-w-7xl mx-auto px-4 py-8">
      <header class="mb-6 flex items-center justify-between">
        <div>
          <p class="text-xs uppercase tracking-widest text-gray-500">MeetingRails</p>
          <h1 class="text-2xl font-bold text-gray-900">Super Admin</h1>
        </div>
        <nav class="flex gap-2">
          <%= link_to "조직", super_admin_organizations_path, class: "px-3 py-2 rounded bg-white border border-gray-200 text-sm text-gray-700 hover:bg-gray-50" %>
          <%= link_to "플랜", super_admin_plans_path, class: "px-3 py-2 rounded bg-white border border-gray-200 text-sm text-gray-700 hover:bg-gray-50" %>
          <%= link_to "메인", root_path, class: "px-3 py-2 rounded bg-gray-800 text-sm text-white hover:bg-black" %>
        </nav>
      </header>

      <% if notice %>
        <div class="mb-4 bg-green-50 border border-green-200 text-green-800 rounded px-4 py-3 text-sm"><%= notice %></div>
      <% end %>
      <% if alert %>
        <div class="mb-4 bg-red-50 border border-red-200 text-red-800 rounded px-4 py-3 text-sm"><%= alert %></div>
      <% end %>

      <%= yield %>
    </div>
  </body>
</html>
