<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Meeting Rails" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Meeting Rails">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-50 min-h-screen">
    <nav class="bg-white shadow-sm border-b border-gray-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between h-16 items-center">
          <div class="flex items-center gap-4">
            <% if current_organization %>
              <%= link_to current_organization.name, tenant_root_path, class: "text-xl font-bold text-blue-600" %>
              <%= link_to "예약 현황", reservations_path, class: "text-gray-600 hover:text-gray-900 text-sm" %>
            <% else %>
              <%= link_to "MeetingRails", root_path, class: "text-xl font-bold text-blue-600" %>
            <% end %>
          </div>
          <div class="flex items-center gap-4">
            <% if user_signed_in? %>
              <% if current_user.admin? %>
                <%= link_to "관리자",
                    admin_root_url(subdomain: current_user.organization.subdomain),
                    class: "text-sm text-blue-600 font-medium" %>
              <% end %>
              <%= link_to "로그아웃", destroy_user_session_path, data: { turbo_method: :delete }, class: "text-sm text-gray-600" %>
            <% else %>
              <%= link_to "로그인", new_user_session_path, class: "text-sm text-gray-600" %>
            <% end %>
          </div>
        </div>
      </div>
    </nav>

    <% if notice %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-green-50 border border-green-200 text-green-800 rounded px-4 py-3 text-sm"><%= notice %></div>
      </div>
    <% end %>
    <% if alert %>
      <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-red-50 border border-red-200 text-red-800 rounded px-4 py-3 text-sm"><%= alert %></div>
      </div>
    <% end %>

    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <%= yield %>
    </main>
  </body>
</html>
