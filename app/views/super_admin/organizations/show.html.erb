<div class="mb-4 flex items-center justify-between">
  <h2 class="text-xl font-semibold text-gray-900"><%= @organization.name %></h2>
  <div class="flex gap-2">
    <%= link_to "수정", edit_super_admin_organization_path(@organization), class: "px-3 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-50" %>
    <%= link_to "삭제",
      super_admin_organization_path(@organization),
      data: { turbo_method: :delete, turbo_confirm: "정말 삭제하시겠습니까?" },
      class: "px-3 py-2 rounded bg-red-600 text-sm text-white hover:bg-red-700" %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white p-6">
  <dl class="grid md:grid-cols-2 gap-4 text-sm">
    <div>
      <dt class="text-gray-500">서브도메인</dt>
      <dd class="font-medium text-gray-900"><%= @organization.subdomain %></dd>
    </div>
    <div>
      <dt class="text-gray-500">활성 상태</dt>
      <dd class="font-medium text-gray-900"><%= @organization.active? ? "활성" : "비활성" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">플랜</dt>
      <dd class="font-medium text-gray-900"><%= @organization.plan&.name || "-" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">구독 상태</dt>
      <dd class="font-medium text-gray-900"><%= @organization.subscription&.status || "-" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Stripe Customer</dt>
      <dd class="font-medium text-gray-900"><%= @organization.stripe_customer_id.presence || "-" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">생성일</dt>
      <dd class="font-medium text-gray-900"><%= l(@organization.created_at, format: :short) %></dd>
    </div>
  </dl>
</div>
