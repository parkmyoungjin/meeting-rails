<div class="mb-4 flex items-center justify-between">
  <h2 class="text-xl font-semibold text-gray-900"><%= @plan.name %></h2>
  <div class="flex gap-2">
    <%= link_to "수정", edit_super_admin_plan_path(@plan), class: "px-3 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-50" %>
    <%= link_to "삭제",
      super_admin_plan_path(@plan),
      data: { turbo_method: :delete, turbo_confirm: "정말 삭제하시겠습니까?" },
      class: "px-3 py-2 rounded bg-red-600 text-sm text-white hover:bg-red-700" %>
  </div>
</div>

<div class="rounded-xl border border-gray-200 bg-white p-6">
  <dl class="grid md:grid-cols-2 gap-4 text-sm">
    <div>
      <dt class="text-gray-500">가격(cent)</dt>
      <dd class="font-medium text-gray-900"><%= @plan.price_cents %></dd>
    </div>
    <div>
      <dt class="text-gray-500">회의실 한도</dt>
      <dd class="font-medium text-gray-900"><%= @plan.room_limit || "무제한" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">Stripe Price ID</dt>
      <dd class="font-medium text-gray-900"><%= @plan.stripe_price_id.presence || "-" %></dd>
    </div>
    <div>
      <dt class="text-gray-500">연결 조직 수</dt>
      <dd class="font-medium text-gray-900"><%= @plan.organizations.count %></dd>
    </div>
  </dl>
</div>
