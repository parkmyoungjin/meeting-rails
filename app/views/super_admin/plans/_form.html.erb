<%= form_with model: [ :super_admin, plan ], class: "space-y-4" do |f| %>
  <% if plan.errors.any? %>
    <div class="rounded border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
      <p class="font-medium mb-1">저장에 실패했습니다.</p>
      <ul class="list-disc ml-5">
        <% plan.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid md:grid-cols-2 gap-4">
    <div>
      <%= f.label :name, "플랜 이름", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :name, class: "w-full rounded border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :price_cents, "월 가격(cent)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :price_cents, class: "w-full rounded border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :room_limit, "회의실 한도(nil=무제한)", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.number_field :room_limit, class: "w-full rounded border border-gray-300 px-3 py-2" %>
    </div>
    <div>
      <%= f.label :stripe_price_id, "Stripe Price ID", class: "block text-sm font-medium text-gray-700 mb-1" %>
      <%= f.text_field :stripe_price_id, class: "w-full rounded border border-gray-300 px-3 py-2" %>
    </div>
  </div>

  <div class="flex gap-2">
    <%= f.submit "저장", class: "px-4 py-2 rounded bg-blue-600 text-white text-sm hover:bg-blue-700" %>
    <%= link_to "취소", super_admin_plans_path, class: "px-4 py-2 rounded border border-gray-300 text-sm text-gray-700 hover:bg-gray-50" %>
  </div>
<% end %>
