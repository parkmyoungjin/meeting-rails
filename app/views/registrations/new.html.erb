<div class="max-w-2xl mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-2 text-center">조직 가입</h1>
  <p class="text-gray-500 text-sm text-center mb-6">1분 내에 무료 플랜으로 시작할 수 있습니다.</p>

  <div class="mb-6 rounded-xl border border-gray-200 bg-white p-4">
    <ol class="grid grid-cols-2 gap-3 text-sm">
      <li class="rounded-lg bg-blue-50 px-3 py-2 text-blue-700 font-medium">1. 조직 정보 입력</li>
      <li class="rounded-lg bg-gray-50 px-3 py-2 text-gray-500">2. 관리자 계정 생성</li>
    </ol>
  </div>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <%= form_with url: registrations_path,
      class: "space-y-5",
      data: {
        controller: "subdomain-check",
        subdomain_check_url_value: subdomain_availability_registrations_path,
        subdomain_check_min_length_value: 3
      } do %>
      <fieldset class="border rounded-lg p-4">
        <legend class="text-sm font-semibold text-gray-700 px-2">조직 정보</legend>
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">조직 이름</label>
            <%= text_field_tag "organization[name]", @organization.name, placeholder: "예: 서울성모병원",
                class: "w-full border border-gray-300 rounded px-3 py-2" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">서브도메인</label>
            <div class="flex items-center gap-2">
              <%= text_field_tag "organization[subdomain]", @organization.subdomain, placeholder: "hospital-a",
                  class: "flex-1 border border-gray-300 rounded px-3 py-2",
                  data: {
                    action: "input->subdomain-check#queue blur->subdomain-check#check",
                    subdomain_check_target: "input"
                  } %>
              <span class="text-gray-400 text-sm">.<%= @base_domain %></span>
            </div>
            <p class="text-xs text-gray-400 mt-1">소문자, 숫자, 하이픈만 사용 가능 (3~63자)</p>
            <p class="text-xs mt-1 text-gray-500" data-subdomain-check-target="status"></p>
          </div>
        </div>
      </fieldset>

      <fieldset class="border rounded-lg p-4">
        <legend class="text-sm font-semibold text-gray-700 px-2">관리자 계정</legend>
        <div class="space-y-3">
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">이메일</label>
            <%= email_field_tag "user[email]", @user.email, class: "w-full border border-gray-300 rounded px-3 py-2" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">비밀번호</label>
            <%= password_field_tag "user[password]", nil, class: "w-full border border-gray-300 rounded px-3 py-2" %>
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1">비밀번호 확인</label>
            <%= password_field_tag "user[password_confirmation]", nil, class: "w-full border border-gray-300 rounded px-3 py-2" %>
          </div>
        </div>
      </fieldset>

      <button type="submit"
              class="w-full bg-blue-600 text-white py-2 rounded font-medium hover:bg-blue-700 disabled:bg-gray-300 disabled:cursor-not-allowed"
              data-subdomain-check-target="submit">
        무료로 시작하기
      </button>
    <% end %>
  </div>
</div>
