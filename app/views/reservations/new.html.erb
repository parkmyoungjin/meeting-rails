<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6"><%= @room.name %> 예약</h1>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <%= form_with model: @reservation, class: "space-y-4",
        data: { controller: "reservation-form" } do |f| %>
      <%= f.hidden_field :room_id, value: @room.id %>

      <% if @reservation.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
          <ul class="list-disc list-inside space-y-1">
            <% @reservation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">날짜</label>
        <%= f.date_field :date, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">시작 시간</label>
          <%= f.time_field :start_time, class: "w-full border border-gray-300 rounded px-3 py-2",
              data: { reservation_form_target: "startTime",
                      action: "change->reservation-form#onStartChange" } %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">종료 시간</label>
          <%= f.time_field :end_time, class: "w-full border border-gray-300 rounded px-3 py-2",
              data: { reservation_form_target: "endTime",
                      action: "change->reservation-form#onEndChange" } %>
        </div>
      </div>
      <p class="text-xs" data-reservation-form-target="durationDisplay"></p>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">예약자</label>
        <%= f.text_field :organizer, placeholder: "이름", class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">목적</label>
        <%= f.text_field :purpose, placeholder: "회의 목적", class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">비밀번호 (수정/삭제 시 필요)</label>
        <%= f.password_field :password, placeholder: "최소 4자리", class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">비밀번호 확인</label>
        <%= f.password_field :password_confirmation, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <%= f.submit "예약하기", class: "w-full bg-blue-600 text-white py-2 rounded font-medium hover:bg-blue-700 cursor-pointer",
          data: { reservation_form_target: "submitBtn" } %>
    <% end %>
  </div>
</div>
