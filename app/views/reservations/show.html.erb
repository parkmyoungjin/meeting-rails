<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">예약 상세</h1>

  <div class="bg-white rounded-xl shadow-sm p-6 space-y-3">
    <div class="flex justify-between">
      <span class="text-gray-500">회의실</span>
      <span class="font-medium"><%= @reservation.room.floor %> — <%= @reservation.room.name %></span>
    </div>
    <div class="flex justify-between">
      <span class="text-gray-500">날짜</span>
      <span class="font-medium"><%= @reservation.date.strftime("%Y년 %m월 %d일") %></span>
    </div>
    <div class="flex justify-between">
      <span class="text-gray-500">시간</span>
      <span class="font-medium">
        <%= @reservation.start_time.strftime("%H:%M") %> ~ <%= @reservation.end_time.strftime("%H:%M") %>
      </span>
    </div>
    <div class="flex justify-between">
      <span class="text-gray-500">예약자</span>
      <span class="font-medium"><%= @reservation.organizer %></span>
    </div>
    <div class="flex justify-between">
      <span class="text-gray-500">목적</span>
      <span class="font-medium"><%= @reservation.purpose %></span>
    </div>
  </div>

  <div class="mt-4 flex gap-3">
    <%= link_to "수정하기", verify_reservation_path(@reservation),
        class: "flex-1 text-center bg-yellow-500 text-white py-2 rounded font-medium hover:bg-yellow-600" %>
    <%= link_to "삭제하기", verify_reservation_path(@reservation),
        data: { confirm: "삭제하시겠습니까?" },
        class: "flex-1 text-center bg-red-500 text-white py-2 rounded font-medium hover:bg-red-600" %>
    <%= link_to "목록으로", reservations_path, class: "flex-1 text-center border text-gray-600 py-2 rounded font-medium hover:bg-gray-50" %>
  </div>
</div>
