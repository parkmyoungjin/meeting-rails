<div class="flex justify-between items-start mb-6">
  <h1 class="text-2xl font-bold text-gray-900"><%= current_organization.name %> 회의실 예약</h1>
  <div class="text-right text-gray-500" data-controller="clock">
    <div class="text-xs">현재 시각</div>
    <div class="text-lg font-mono font-semibold" data-clock-target="display"></div>
  </div>
</div>

<!-- 필터 폼 -->
<div class="bg-white rounded-xl shadow-sm p-4 mb-6">
  <%= form_with url: reservations_path, method: :get, class: "flex items-end gap-4" do |f| %>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">날짜</label>
      <%= f.date_field :date, value: @date, class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">층</label>
      <%= f.select :floor, @floors, { include_blank: "층 선택" },
          class: "border border-gray-300 rounded px-3 py-2 text-sm" %>
    </div>
    <%= f.submit "조회", class: "bg-blue-600 text-white px-4 py-2 rounded text-sm font-medium hover:bg-blue-700 cursor-pointer" %>
  <% end %>
</div>

<% if @floor.blank? %>
  <div class="text-center py-12 text-gray-500">층을 선택하면 예약 현황을 볼 수 있습니다.</div>
<% elsif @rooms.empty? %>
  <div class="text-center py-12 text-gray-500">해당 층에 활성화된 회의실이 없습니다.</div>
<% else %>
  <%= render "timeline", rooms: @rooms, reservations: @reservations, date: @date %>
<% end %>
