<div class="max-w-lg mx-auto">
  <h1 class="text-2xl font-bold text-gray-900 mb-6">예약 수정</h1>

  <div class="bg-white rounded-xl shadow-sm p-6">
    <%= form_with model: @reservation, class: "space-y-4" do |f| %>
      <% if @reservation.errors.any? %>
        <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
          <ul class="list-disc list-inside">
            <% @reservation.errors.full_messages.each do |msg| %>
              <li><%= msg %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">시작 시간</label>
          <%= f.time_field :start_time, class: "w-full border border-gray-300 rounded px-3 py-2" %>
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">종료 시간</label>
          <%= f.time_field :end_time, class: "w-full border border-gray-300 rounded px-3 py-2" %>
        </div>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">예약자</label>
        <%= f.text_field :organizer, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">목적</label>
        <%= f.text_field :purpose, class: "w-full border border-gray-300 rounded px-3 py-2" %>
      </div>

      <%= f.submit "수정 완료", class: "w-full bg-blue-600 text-white py-2 rounded font-medium hover:bg-blue-700 cursor-pointer" %>
    <% end %>
  </div>
</div>
