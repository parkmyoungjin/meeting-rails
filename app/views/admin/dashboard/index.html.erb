<h1 class="text-2xl font-bold text-gray-900 mb-6">대시보드</h1>

<div class="grid grid-cols-3 gap-6 mb-8">
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500">활성 회의실</p>
    <p class="text-3xl font-bold text-blue-600 mt-1"><%= @total_rooms %>개</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500">오늘 예약</p>
    <p class="text-3xl font-bold text-green-600 mt-1"><%= @today_reservations %>건</p>
  </div>
  <div class="bg-white rounded-xl shadow-sm p-6">
    <p class="text-sm text-gray-500">이번 달 예약</p>
    <p class="text-3xl font-bold text-purple-600 mt-1"><%= @this_month %>건</p>
  </div>
</div>

<div class="bg-white rounded-xl shadow-sm p-6">
  <h2 class="font-semibold text-gray-900 mb-4">최근 예약</h2>
  <% if @recent_reservations.empty? %>
    <p class="text-gray-400 text-sm">예약 내역이 없습니다.</p>
  <% else %>
    <table class="w-full text-sm">
      <thead class="text-gray-500 border-b">
        <tr>
          <th class="text-left pb-2">날짜</th>
          <th class="text-left pb-2">시간</th>
          <th class="text-left pb-2">회의실</th>
          <th class="text-left pb-2">예약자</th>
          <th class="text-left pb-2">목적</th>
        </tr>
      </thead>
      <tbody class="divide-y">
        <% @recent_reservations.each do |r| %>
          <tr>
            <td class="py-2"><%= r.date.strftime("%m/%d") %></td>
            <td class="py-2"><%= r.start_time.strftime("%H:%M") %>~<%= r.end_time.strftime("%H:%M") %></td>
            <td class="py-2"><%= r.room.name %></td>
            <td class="py-2"><%= r.organizer %></td>
            <td class="py-2 text-gray-500"><%= r.purpose %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
