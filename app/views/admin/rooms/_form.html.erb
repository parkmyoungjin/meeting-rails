<div class="bg-white rounded-xl shadow-sm p-6 max-w-lg">
  <%= form_with model: [:admin, room], class: "space-y-4" do |f| %>
    <% if room.errors.any? %>
      <div class="bg-red-50 border border-red-200 rounded p-3 text-sm text-red-700">
        <ul class="list-disc list-inside">
          <% room.errors.full_messages.each do |msg| %>
            <li><%= msg %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">층</label>
      <%= f.text_field :floor, placeholder: "예: 1층, 2층, B1", class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">회의실 이름</label>
      <%= f.text_field :name, placeholder: "예: 소회의실 A", class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div>
      <label class="block text-sm font-medium text-gray-700 mb-1">정원</label>
      <%= f.number_field :capacity, min: 1, class: "w-full border border-gray-300 rounded px-3 py-2" %>
    </div>

    <div class="flex items-center gap-2">
      <%= f.check_box :active, class: "rounded border-gray-300" %>
      <label class="text-sm text-gray-700">활성화</label>
    </div>

    <%= f.submit room.new_record? ? "추가하기" : "수정하기",
        class: "w-full bg-blue-600 text-white py-2 rounded font-medium hover:bg-blue-700 cursor-pointer" %>
  <% end %>
</div>
